{
  "name": "pokemon-champions-stat-lab",
  "version": "19.0.0",
  "private": true,
  "description": "Pokémon Champions Stat Lab web/PWA and Capacitor Android app",
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "android": "npm run sync && npm run open:android",
    "build:debug": "cd android && gradlew.bat assembleDebug",
    "build:release": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
